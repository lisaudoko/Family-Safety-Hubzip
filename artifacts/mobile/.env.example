# Public (EXPO_PUBLIC_*) build-time variables for the mobile app. These are
# embedded in the shipped binary - never put secrets here.
#
# For EAS builds do NOT commit real values. Create them per environment:
#   eas env:create --environment production --name EXPO_PUBLIC_DOMAIN --value api.example.com --visibility plaintext
# (repeat for each variable below, and for "preview" / "development"). eas.json
# maps each build profile to the EAS environment of the same name.

# API host only, no scheme or path (the app calls https://<domain>/api/...).
# If unset on a native build every API request fails - set it for every profile.
EXPO_PUBLIC_DOMAIN=

# RevenueCat public SDK keys. Missing keys disable subscriptions, not the app.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
