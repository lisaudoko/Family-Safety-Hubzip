# SMTP credentials for sending password reset emails via nodemailer.
# If SMTP_HOST is unset, reset codes are logged to the server console instead
# of being emailed, so the flow is still testable without real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@digitalvillage.app

# Stripe billing (test mode keys while developing).
# STRIPE_WEBHOOK_SECRET comes from `stripe listen --forward-to localhost:<port>/api/billing/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# Deep link scheme the mobile app returns to after Stripe Checkout/Portal (matches app.json "scheme").
MOBILE_APP_SCHEME=digitalvillage

# In-app purchases (RevenueCat). The family id is the RevenueCat app user id.
# SECRET key (server only, never in the app) used to verify entitlements:
REVENUECAT_SECRET_API_KEY=
# Entitlement identifier configured in RevenueCat (default: premium).
REVENUECAT_ENTITLEMENT_ID=premium
# Value RevenueCat sends in the Authorization header of its webhook
# (POST /api/billing/revenuecat-webhook), e.g. "Bearer <long random string>".
REVENUECAT_WEBHOOK_AUTH=
