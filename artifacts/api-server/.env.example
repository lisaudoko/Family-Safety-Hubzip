# SMTP credentials for sending password reset emails via nodemailer.
# If SMTP_HOST is unset, reset codes are logged to the server console instead
# of being emailed, so the flow is still testable without real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@digitalvillage.app

# Stripe billing (test mode keys while developing).
# STRIPE_WEBHOOK_SECRET comes from `stripe listen --forward-to localhost:<port>/api/billing/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# Deep link scheme the mobile app returns to after Stripe Checkout/Portal (matches app.json "scheme").
MOBILE_APP_SCHEME=mobile
